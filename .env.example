# For running locally (npm run dev): copy to .env.local and fill in from your
# Supabase project (Project Settings > API Keys). The published app gets these
# from the repository variables SUPABASE_URL and SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (a.k.a. publishable) key. Never the service_role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
