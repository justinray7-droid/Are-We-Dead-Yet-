# Copy to .env.local and fill in from your Supabase project (Project Settings > API Keys).
# Server-only: these never reach the browser, so the database is reachable only through the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (a.k.a. publishable) key. Never use the service_role/secret key here.
SUPABASE_ANON_KEY=your-anon-key
